# 示例模板：复制到 ECS 的 /etc/studyroom/cloud.env 后填写真实值
#   sudo mkdir -p /etc/studyroom
#   sudo cp deploy/cloud.env.example /etc/studyroom/cloud.env
#   sudo chmod 600 /etc/studyroom/cloud.env
#   sudo vi /etc/studyroom/cloud.env
#
# 此文件仅放 ECS 本机，禁止提交到仓库；仓库内只保留空值模板。
# 全部留空时后端走 HTTP 端点（默认本机 mock_fg 模拟器）。
# 填齐下面 4 项后，systemd 通过 EnvironmentFile 注入，页面来源变为真·FunctionGraph。

FG_SDK_AK=
FG_SDK_SK=
FG_SDK_PROJECT_ID=
FG_SDK_FUNCTION_NAME=
# 也可直接粘贴控制台的完整函数 URN（优先于 FG_SDK_FUNCTION_NAME）：
# FG_SDK_FUNCTION_URN=urn:fss:cn-north-4:<projectId>:function:default:billing-func:latest
FG_SDK_REGION=cn-north-4

# 仅本地 mock 联调时覆盖 SDK 端点，正式部署必须留空
# FG_SDK_ENDPOINT=http://127.0.0.1:9999

# 兼容旧部署：不启用 AK/SK 时使用的 HTTP 触发器 URL / 模拟器地址
# FG_ENDPOINT=http://127.0.0.1:9100/billing
