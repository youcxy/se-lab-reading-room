# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，禁止提交
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reading_room
DB_USER=study
DB_PASSWORD=Study@123456

# ---------------------------------------------------------------------------
# 云端计费（三选一，优先级从上到下）
# ---------------------------------------------------------------------------
# ① 推荐：AK/SK 直调 FunctionGraph 同步执行 API（真云端，免费，无需 APIG）
#    密钥只放本机环境变量或 ECS 的 /etc/studyroom/cloud.env（权限 600），绝不进仓库
FG_SDK_AK=
FG_SDK_SK=
FG_SDK_PROJECT_ID=
FG_SDK_FUNCTION_NAME=
# FG_SDK_FUNCTION_URN=urn:fss:cn-north-4:<projectId>:function:default:billing-func:latest
FG_SDK_REGION=cn-north-4
# FG_SDK_ENDPOINT=          # 仅本地 mock 联调覆盖用，正式留空

# ② 兼容旧部署：APIG 触发器 URL 或本地模拟器（未启用 ① 时生效）
# FG_ENDPOINT=http://127.0.0.1:9100/billing

# ③ 若 ①② 都没配，后端用本地同一算法计算，来源记为 LOCAL
FG_TIMER_CRON=0 0 2 * * ?

# 业务默认值
DEFAULT_HOURLY_PRICE=4.00
DAY_CARD_PRICE=30.00
OVERTIME_MINUTES=15
CREDIT_PENALTY=10
MIN_CREDIT_TO_BOOK=60
OCCUPANCY_THRESHOLD=0.8
